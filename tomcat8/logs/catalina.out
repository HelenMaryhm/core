  <identifier>eae2538a-6bc0-4d27-916f-bbc5d7ca45c5</identifier>
  <source>DB</source>
  <title>Landing Page</title>
  <friendlyName>Landing page template used in conjunction with the landing page content type</friendlyName>
  <modDate class="sql-timestamp">2017-03-10 14:15:13.58</modDate>
  <modUser>dotcms.org.1</modUser>
  <sortOrder>0</sortOrder>
  <showOnMenu>true</showOnMenu>
  <body>&lt;!DOCTYPE html&gt;&#xd;
&lt;html&gt;     &#xd;
&lt;head&gt;&#xd;
#dotParse(&apos;/application/themes/landing-page/html_head.vtl&apos;)&#xd;
&lt;/head&gt;&#xd;
&#xd;
&lt;body id=&quot;top&quot;&gt;&#xd;
&#xd;
&lt;!-- HERO BANNER SM --&gt;&#xd;
&lt;section id=&quot;banner&quot;&gt;&#xd;
	&lt;div class=&quot;lp-header&quot;&gt;&#xd;
	    &lt;div class=&quot;lp-duo-tone&quot;&gt;&#xd;
	        &lt;div class=&quot;container&quot;&gt;&#xd;
	        	&lt;div class=&quot;row&quot;&gt;&#xd;
					&lt;div class=&quot;col-xs-4&quot;&gt;&#xd;
						&lt;div class=&quot;lp-logo&quot;&gt;&#xd;
							&lt;a class=&quot;navbar-brand&quot; href=&quot;/&quot;&gt;&#xd;
					        &lt;img alt=&quot;dotCMS Sample Landing Page&quot; src=&quot;/dA/82ad305a-621d/200w/quest-logo.png&quot; alt=&quot;dotCMS Demo Site&quot;&gt;&#xd;
					    &lt;/a&gt;&#xd;
						&lt;/div&gt;&#xd;
					&lt;/div&gt;&#xd;
					&lt;div class=&quot;col-sm-7 col-xs-8&quot;&gt;&#xd;
						&lt;div class=&quot;lp-phone&quot;&gt;&#xd;
							&lt;a href=&quot;tel:13059002001&quot;&gt;&#xd;
								&lt;span class=&quot;fa-stack fa-lg text-pink&quot;&gt;&lt;i class=&quot;fa fa-circle fa-stack-2x&quot;&gt;&lt;/i&gt;&lt;i class=&quot;fa fa-phone fa-stack-1x fa-inverse&quot;&gt;&lt;/i&gt;&lt;/span&gt;&#xd;
								+1 305 900-2001&#xd;
							&lt;/a&gt;&#xd;
						&lt;/div&gt;&#xd;
					&lt;/div&gt;&#xd;
				&lt;/div&gt;&#xd;
				&lt;div class=&quot;row&quot;&gt;&#xd;
		            &lt;div class=&quot;col-md-8&quot;&gt;&#xd;
		            	&lt;div class=&quot;lp-content&quot;&gt;&#xd;
			                &lt;h1&gt;$!{dotPageContent.title}&lt;/h1&gt;&#xd;
			                &lt;h2&gt;$!{dotPageContent.subtitle}&lt;/h2&gt;&#xd;
			                &lt;p&gt;$!{dotPageContent.caption}&lt;/p&gt;&#xd;
		            	&lt;/div&gt;&#xd;
&#xd;
		            	&lt;form role=&quot;form&quot; id=&quot;contactForm&quot; class=&quot;contact-form&quot;&gt;&#xd;
		            		&lt;div class=&quot;lp-form&quot;&gt;&#xd;
		            			&lt;div class=&quot;row&quot;&gt;&#xd;
		            				&lt;div class=&quot;col-xs-12&quot;&gt;&#xd;
										&lt;h3&gt;Speak to retirement specialist&lt;/h3&gt;&#xd;
									&lt;/div&gt;&#xd;
								&lt;/div&gt;&#xd;
								&lt;div class=&quot;row&quot;&gt;&#xd;
									&lt;div class=&quot;col-sm-6&quot;&gt;&#xd;
										&lt;!-- FIRST NAME --&gt;&#xd;
										&lt;div class=&quot;form-group&quot;&gt;&#xd;
											&lt;div class=&quot;col-sm-12&quot;&gt;&#xd;
												&lt;input type=&quot;text&quot; id=&quot;firstName&quot; class=&quot;form-control&quot; name=&quot;firstName&quot; value=&quot;&quot; placeholder=&quot;First Name&quot; required=&quot;&quot;&gt;&#xd;
											&lt;/div&gt;&#xd;
										&lt;/div&gt;&#xd;
					&#xd;
										&lt;!-- LAST NAME --&gt;&#xd;
										&lt;div class=&quot;form-group&quot;&gt;&#xd;
											&lt;div class=&quot;col-sm-12&quot;&gt;&#xd;
												&lt;input type=&quot;text&quot; id=&quot;lastName&quot; class=&quot;form-control&quot; name=&quot;lastName&quot; value=&quot;&quot; placeholder=&quot;Last Name&quot; required=&quot;&quot;&gt;&#xd;
											&lt;/div&gt;&#xd;
										&lt;/div&gt;&#xd;
									&lt;/div&gt;&#xd;
									&lt;div class=&quot;col-sm-6&quot;&gt;&#xd;
									&lt;!-- EMAIL --&gt;&#xd;
										&lt;div class=&quot;form-group&quot;&gt;&#xd;
											&lt;div class=&quot;col-sm-12&quot;&gt;&#xd;
												&lt;input type=&quot;email&quot; id=&quot;email&quot; class=&quot;form-control&quot; name=&quot;email&quot; value=&quot;&quot; placeholder=&quot;Email&quot; required=&quot;&quot;&gt;&#xd;
											&lt;/div&gt;&#xd;
										&lt;/div&gt;&#xd;
&#xd;
										&lt;!-- Phone --&gt;&#xd;
										&lt;div class=&quot;form-group&quot;&gt;&#xd;
											&lt;div class=&quot;col-sm-12&quot;&gt;&#xd;
												&lt;input type=&quot;text&quot; class=&quot;form-control&quot; id=&quot;phone&quot; name=&quot;&quot; value=&quot;&quot; placeholder=&quot;Phone&quot; required=&quot;&quot;&gt;&#xd;
											&lt;/div&gt;&#xd;
										&lt;/div&gt;&#xd;
									&lt;/div&gt;&#xd;
								&lt;/div&gt;&#xd;
								&lt;div class=&quot;text-center&quot;&gt;&#xd;
									&lt;button type=&quot;submit&quot; id=&quot;submit-btn&quot; class=&quot;btn btn-lg&quot;&gt;Submit&lt;/button&gt;&#xd;
								&lt;/div&gt;&#xd;
							&lt;/div&gt;&#xd;
		            	&lt;/form&gt;&#xd;
		            &lt;/div&gt;&#xd;
		        &lt;/div&gt;&#xd;
	        &lt;/div&gt;&#xd;
	    &lt;/div&gt;&#xd;
	&lt;/div&gt;&#xd;
&lt;/section&gt;&#xd;
&#xd;
&lt;section id=&quot;related-products&quot;&gt;&#xd;
	&lt;div class=&quot;bg-gray-lighter&quot;&gt;&#xd;
	    &lt;div class=&quot;container&quot;&gt;&#xd;
            &lt;div class=&quot;row&quot;&gt;&#xd;
                #foreach($prod in $dotcontent.pullRelated(&quot;LandingPage-Products&quot;,&quot;$!{dotPageContent.identifier}&quot;,false,4)) &#xd;
            	    &lt;div class=&quot;col-sm-3 col-xs-6&quot;&gt;&#xd;
            	        &lt;div class=&quot; lp-prod&quot; onclick=&quot;window.location.href=&apos;/products/$!{prod.urlTitle}&quot;&gt;&#xd;
            	            &lt;b&gt;$!{prod.title} ($!{prod.tickerSymbol})&lt;/b&gt;&#xd;
            	            &lt;div class=&quot;risk-system risk${prod.risk.selectValue}&quot; title=&quot;${prod.risk.selectValue}&quot;&gt;&#xd;
            	                &lt;span class=&quot;hidden&quot;&gt;${prod.risk.selectValue}&lt;/span&gt;&#xd;
            	            &lt;/div&gt;&#xd;
            	        &lt;/div&gt;&#xd;
            	    &lt;/div&gt;&#xd;
                #end&#xd;
           &lt;/div&gt;&#xd;
	    &lt;/div&gt;&#xd;
	&lt;/div&gt;&#xd;
&lt;/section&gt;&#xd;
&#xd;
&lt;section id=&quot;trust&quot;&gt;&#xd;
	&lt;div class=&quot;defualt-wrapper&quot;&gt;&#xd;
	    &lt;div class=&quot;container&quot;&gt;&#xd;
	    	&lt;div class=&quot;row margin-bottom-sm&quot;&gt;&#xd;
				&lt;div class=&quot;col-sm-10 col-xs-12 col-sm-offset-1 text-center&quot;&gt;&#xd;
					&lt;h2 class=&quot;text-pink text-lg&quot;&gt;Why TargetQuest?&lt;/h2&gt;&#xd;
					&lt;p class=&quot;lead&quot;&gt;We asked our customers here is what they said.&lt;/p&gt;&#xd;
				&lt;/div&gt;&#xd;
			&lt;/div&gt;&#xd;
			&lt;div class=&quot;row&quot;&gt;&#xd;
			    #foreach($client in $dotcontent.pullRelated(&quot;LandingPage-Testimonial&quot;,&quot;$!{dotPageContent.identifier}&quot;,false,3)) &#xd;
    				&lt;div class=&quot;col-sm-4&quot;&gt;&#xd;
    					&lt;div class=&quot;quote-wrapper&quot;&gt;&#xd;
    						&lt;div class=&quot;author-img&quot; style=&quot;background-image: url(&apos;/dA/$client.identifier/250w/$client.photo.name&apos;);&quot;&gt;&lt;/div&gt;&#xd;
    						&lt;blockquote&gt;&amp;ldquo;$!{client.quote}&amp;rdquo;&lt;/blockquote&gt;&#xd;
    						&lt;div class=&quot;author&quot;&gt;&lt;strong&gt;$!{client.qname}&lt;/strong&gt;&lt;/div&gt;&#xd;
    						&lt;div class=&quot;title&quot;&gt;$!{client.title}&lt;/div&gt;&#xd;
    						&lt;div class=&quot;company&quot;&gt;$!{client.company}&lt;/div&gt;&#xd;
    						&lt;div class=&quot;rating&quot;&gt;&#xd;
    							&lt;i class=&quot;fa fa-star fa-lg&quot;&gt;&lt;/i&gt;&#xd;
    							&lt;i class=&quot;fa fa-star fa-lg&quot;&gt;&lt;/i&gt;&#xd;
    							&lt;i class=&quot;fa fa-star fa-lg&quot;&gt;&lt;/i&gt;&#xd;
    							&lt;i class=&quot;fa fa-star fa-lg&quot;&gt;&lt;/i&gt;&#xd;
    							&lt;i class=&quot;fa fa-star fa-lg&quot;&gt;&lt;/i&gt;&#xd;
    						&lt;/div&gt;&#xd;
    					&lt;/div&gt;&#xd;
    				&lt;/div&gt;&#xd;
    			#end&#xd;
			&lt;/div&gt;&#xd;
		&lt;/div&gt;&#xd;
	&lt;/div&gt;&#xd;
&lt;/section&gt;&#xd;
  		       &#xd;
&lt;div id=&quot;section3&quot;&gt;&#xd;
	&lt;div class=&quot;defualt-wrapper bg-gray-lighter&quot;&gt;&#xd;
		## Container: Large Column (lg-1)&#xd;
        ## This is autogenerated code that cannot be changed&#xd;
        #parseContainer(&apos;a050073a-a31e-4aab-9307-86bfb248096a&apos;)&#xd;
	&lt;/div&gt;&#xd;
&lt;/div&gt;	      	&#xd;
&#xd;
&lt;!-- FOOTER CALL TO ACTION --&gt;&#xd;
&lt;section id=&quot;cta2&quot;&gt;&#xd;
	&lt;div class=&quot;bg-pink&quot;&gt;&#xd;
	    &lt;div class=&quot;container&quot;&gt;&#xd;
	    	&lt;div class=&quot;row margin-top-md margin-bottom-md&quot;&gt;&#xd;
		        &lt;div class=&quot;col-sm-8&quot;&gt;&#xd;
		            &lt;h2&gt;Want to learn more? Lets talk. Drop us line and lets get started.&lt;/h2&gt;&#xd;
		        &lt;/div&gt;&#xd;
		        &lt;div class=&quot;col-sm-4&quot;&gt;&#xd;
		        	&lt;a href=&quot;#&quot; class=&quot;btn btn-lg&quot;&gt;Get Started&lt;/a&gt;&#xd;
		        &lt;/div&gt;&#xd;
		    &lt;/div&gt;&#xd;
	    &lt;/div&gt;&#xd;
	&lt;/div&gt;&#xd;
&lt;/section&gt;       	 &#xd;
        &#xd;
&lt;!-- FOOTER --&gt;&#xd;
#dotParse(&apos;/application/themes/landing-page/footer.vtl&apos;)&#xd;
&lt;/body&gt;&#xd;
&lt;/html&gt;</body>
