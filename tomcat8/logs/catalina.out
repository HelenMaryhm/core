  <title>Quest - Homepage</title>
  <friendlyName>Quest - Default homepage template</friendlyName>
  <modDate class="sql-timestamp">2018-06-19 18:08:33.975</modDate>
  <modUser>dotcms.org.1</modUser>
  <sortOrder>0</sortOrder>
  <showOnMenu>true</showOnMenu>
  <body>&lt;!DOCTYPE html&gt;&#xd;
&lt;html lang=&quot;en&quot;&gt;&#xd;
&lt;!--[if lt IE 7]&gt;      &lt;html class=&quot;no-js lt-ie9 lt-ie8 lt-ie7&quot;&gt; &lt;![endif]--&gt;&#xd;
&lt;!--[if IE 7]&gt;         &lt;html class=&quot;no-js lt-ie9 lt-ie8&quot;&gt; &lt;![endif]--&gt;&#xd;
&lt;!--[if IE 8]&gt;         &lt;html class=&quot;no-js lt-ie9&quot;&gt; &lt;![endif]--&gt;&#xd;
&lt;!--[if gt IE 8]&gt;&lt;!--&gt; &lt;html class=&quot;no-js&quot;&gt; &lt;!--&lt;![endif]--&gt;&#xd;
  &#xd;
#set($dotTheme = $contents.getEmptyMap())&#xd;
#set($blah1 = $dotTheme.put(&quot;path&quot;, &quot;/application/themes/quest/&quot;))&#xd;
  &#xd;
#set($dotThemeLayout = $contents.getEmptyMap())&#xd;
#set($blah2 = $dotThemeLayout.put(&quot;title&quot;, &quot;Quest Homepage&quot;))&#xd;
&#xd;
&lt;head&gt;  &#xd;
    #dotParse(&quot;${dotTheme.path}html_head.vtl&quot;)&#xd;
&lt;/head&gt;&#xd;
#set($utilClass = $pageTitle.toLowerCase().replace(&apos; &apos;, &apos;-&apos;))&#xd;
&#xd;
&lt;body class=&quot;home-page $utilClass&quot;&gt;&#xd;
&#xd;
    #dotParse(&quot;${dotTheme.path}header.vtl&quot;)&#xd;
    &#xd;
    &lt;div class=&quot;content-wrap&quot;&gt;&#xd;
        #if($EDIT_MODE) &lt;div class=&quot;container&quot; style=&quot;margin-top:150px;&quot;&gt; #end&#xd;
            ## This is autogenerated code that cannot be changed&#xd;
            ## Container: Large Column (lg-1)&#xd;
            ## This is autogenerated code that cannot be changed&#xd;
            #parseContainer(&apos;a050073a-a31e-4aab-9307-86bfb248096a&apos;)&#xd;
        #if($EDIT_MODE) &lt;/div&gt; #end&#xd;
    &#xd;
        &lt;div class=&quot;container&quot;&gt;&#xd;
            &lt;div class=&quot;row row-lined&quot;&gt;&#xd;
                &lt;div class=&quot;col&quot;&gt;&#xd;
                    ## Container: Promotions (Homepage)&#xd;
                    ## This is autogenerated code that cannot be changed&#xd;
                    #parseContainer(&apos;3f0255e8-b45d-46ea-8bb7-eb6597db4c1e&apos;,&apos;promo1&apos;)&#xd;
                &lt;/div&gt;&#xd;
                &lt;div class=&quot;col&quot;&gt;&#xd;
                    ## Container: Promotions (Homepage)&#xd;
                    ## This is autogenerated code that cannot be changed&#xd;
                    #parseContainer(&apos;3f0255e8-b45d-46ea-8bb7-eb6597db4c1e&apos;,&apos;promo2&apos;)&#xd;
                &lt;/div&gt;&#xd;
                &lt;div class=&quot;col&quot;&gt;&#xd;
                    ## Container: Promotions (Homepage)&#xd;
                    ## This is autogenerated code that cannot be changed&#xd;
                    #parseContainer(&apos;3f0255e8-b45d-46ea-8bb7-eb6597db4c1e&apos;,&apos;promo3&apos;)&#xd;
                &lt;/div&gt;&#xd;
                &lt;div class=&quot;col&quot;&gt;&#xd;
                    ## Container: Promotions (Homepage)&#xd;
                    ## This is autogenerated code that cannot be changed&#xd;
                    #parseContainer(&apos;3f0255e8-b45d-46ea-8bb7-eb6597db4c1e&apos;,&apos;promo4&apos;)&#xd;
                &lt;/div&gt;&#xd;
            &lt;/div&gt;&#xd;
&#xd;
            &lt;div class=&quot;row&quot;&gt;&#xd;
                &lt;div class=&quot;col-sm-12 col-md-8&quot;&gt;&#xd;
                    ## Container: Medium Column (md-2)&#xd;
                    ## This is autogenerated code that cannot be changed&#xd;
                    #parseContainer(&apos;bf26b7b2-7a97-4bb6-9887-834ea03341db&apos;)&#xd;
                &lt;/div&gt;&#xd;
                &lt;div class=&quot;col-sm-12 col-md-4&quot;&gt;&#xd;
                    ## Container: Medium Column (md-3)&#xd;
                    ## This is autogenerated code that cannot be changed&#xd;
                    #parseContainer(&apos;d5f5f4ee-067e-4d72-addd-afd80989f684&apos;)&#xd;
                &lt;/div&gt;&#xd;
            &lt;/div&gt;&#xd;
        &lt;/div&gt;&#xd;
    &lt;/div&gt;&#xd;
&#xd;
    #dotParse(&quot;${dotTheme.path}footer.vtl&quot;)&#xd;
    &lt;a href=&quot;http://www.dotcms.com&quot; style=&quot;display:block;position:fixed;bottom:-175px;&quot;&gt;Powered by Dotcms - The Leading Open Source Java Content Management System&lt;/a&gt;&#xd;
&lt;/body&gt;&#xd;
&lt;/html&gt;</body>
