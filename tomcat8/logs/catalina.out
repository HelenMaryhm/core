		&lt;img src=&quot;//chart.finance.yahoo.com/c/5b/v/$!{tickerSymbol}?lang=en-US&amp;region=US&amp;width=300&amp;height=180&quot; alt=&quot;Chart for $!{tickerSymbol}&quot; width=&quot;100%&quot;&gt;&#xd;
	&lt;/div&gt;&#xd;
&lt;/div&gt;&#xd;
&lt;div class=&quot;row&quot;&gt;&#xd;
