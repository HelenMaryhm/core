  <code>&lt;script&gt;&#xd;
    $(document).ready(function() {&#xd;
&#xd;
        jQuery.getJSON(&quot;https://query.yahooapis.com/v1/public/yql?q=select%20*%20from%20yahoo.finance.quotes%20where%20symbol%20in%20(%22$!{tickerSymbol}%22)&amp;format=json&amp;env=store%3A%2F%2Fdatatables.org%2Falltableswithkeys&amp;callback=?&quot;,&#xd;
	    function(data) {&#xd;
	      var q = (data.query.results.quote.PreviousClose);&#xd;
	      var x = (data.query.results.quote.Change);&#xd;
	      var y = (data.query.results.quote.PercentChange);&#xd;
	&#xd;
	      jQuery(&quot;#price$!{tickerSymbol}MD&quot;).append(q);&#xd;
	&#xd;
	      if (x.indexOf(&quot;-&quot;) != -1) {&#xd;
