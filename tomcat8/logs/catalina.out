	      } else {&#xd;
	        var x = &quot;&lt;span&gt;&amp;nbsp;&quot; + x + &quot;&amp;nbsp;(&quot; + y + &quot;)&lt;/span&gt;&quot;;&#xd;
	      }&#xd;
	      jQuery(&quot;#change$!{tickerSymbol}MD&quot;).append(x);&#xd;
	    });&#xd;
&#xd;
	});&#xd;
&lt;/script&gt;&#xd;
&lt;div class=&quot;row&quot;&gt;&#xd;
