  <body>&lt;html&gt;
 &lt;head&gt;
  #dotParse(&apos;//demo.dotcms.com/application/themes/quest/html_head.vtl&apos;)
  &lt;link rel=&quot;stylesheet&quot; type=&quot;text/css&quot; href=&quot;/html/css/template/reset-fonts-grids.css&quot; /&gt;
 &lt;/head&gt;
 &lt;body&gt;
  &lt;div id=&quot;resp-template&quot; name=&quot;globalContainer&quot; class=&quot;yui-t1-template&quot;&gt;
   &lt;div id=&quot;hd-template&quot;&gt;
    #dotParse(&apos;//demo.dotcms.com/application/themes/quest/header.vtl&apos;)
   &lt;/div&gt;
   &lt;div id=&quot;bd-template&quot;&gt;
    &lt;div id=&quot;yui-main-template&quot;&gt;
     &lt;div class=&quot;yui-b-template&quot; id=&quot;splitBody0&quot;&gt;
      &lt;div class=&quot;yui-gc-template&quot; id=&quot;yui-gc-template&quot;&gt;
       &lt;div class=&quot;yui-u-template first&quot; id=&quot;0_yui-u-grid-1&quot;&gt;
        #parseContainer(&apos;a050073a-a31e-4aab-9307-86bfb248096a&apos;)
       &lt;/div&gt;
       &lt;div class=&quot;yui-u-template&quot; id=&quot;0_yui-u-grid-2&quot;&gt;
        #parseContainer(&apos;5363c6c6-5ba0-4946-b7af-cf875188ac2e&apos;)
       &lt;/div&gt;
